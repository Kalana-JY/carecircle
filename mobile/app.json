{
  "expo": {
    "name": "CareCircle",
    "slug": "carecircle",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/cc_logo.png",
    "scheme": "carecircle",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.carecircle.app",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/cc_logo.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/cc_logo.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/cc_logo.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/cc_logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#285F8E",
          "dark": {
            "backgroundColor": "#285F8E"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-sharing",
      "expo-image",
      "expo-web-browser",
      "expo-secure-store"
    ],
    "experiments": {
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "662c7f46-3d70-46de-a963-2d0f8a63f2ac"
      }
    }
  }
}
